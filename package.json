{
  "name": "andromedaconsole",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AndromedaConsole: a local console that runs and shows several Claude Code sessions",
  "author": "AndromedaConsole",
  "main": "out/main/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "console": "tsx src/server/cli.ts",
    "dev": "tsx watch src/server/cli.ts serve",
    "build": "tsx scripts/build-ui.ts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ticket": "tsx scripts/test-ticket.ts",
    "test:changed": "npm run check && vitest run --changed origin/main --passWithNoTests",
    "ci-crash-stats": "tsx scripts/ci-crash-stats.ts",
    "test:smoke": "npm run check && vitest run test/server.test.ts test/merge-ticket.test.ts test/spawn.test.ts test/pty-manager.test.ts test/git-worktree.test.ts test/v1.test.ts test/i18n-checks.test.ts",
    "check": "tsx scripts/check-i18n.ts && tsx scripts/check-ui-literals.ts && tsx scripts/check-mod.ts && tsx scripts/check-test-conventions.ts && tsc -p tsconfig.json --noEmit",
    "hooks": "tsx scripts/install-hooks.ts",
    "shot": "tsx scripts/shot.ts",
    "shot:readme": "tsx scripts/shot-readme.ts",
    "build:app": "tsx scripts/build-app.ts",
    "dist:dir": "npm run build:app && electron-builder --dir",
    "dist": "npm run build:app && electron-builder --publish never",
    "smoke:app": "tsx scripts/smoke-app.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "node-notifier": "^11.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/node-notifier": "^8.0.5",
    "@types/ws": "^8.18.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
